from airflow import DAG
from airflow.operators.bash import BashOperator
from datetime import datetime

with DAG("concurrent_loader",
         start_date=datetime(2024,1,1),
         schedule_interval="@hourly",
         catchup=False) as dag:

    generate = BashOperator(
        task_id="generate",
        bash_command="python /python/generate_data.py"
    )

    load = BashOperator(
        task_id="concurrent_load",
        bash_command="python /python/concurrent_load.py"
    )

    merge = BashOperator(
        task_id="merge",
        bash_command="python /python/safe_merge.py"
    )

    generate >> load >> merge


