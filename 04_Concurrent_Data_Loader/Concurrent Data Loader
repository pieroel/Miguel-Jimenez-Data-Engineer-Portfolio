🧵 concurrent_load.py
import threading
import pandas as pd
import snowflake.connector
import uuid

df = pd.read_csv("data.csv")

def load_chunk(chunk):
    batch = str(uuid.uuid4())
    conn = snowflake.connector.connect(...)
    cur = conn.cursor()
    
    for _, r in chunk.iterrows():
        cur.execute("""
        INSERT INTO sales_staging VALUES (%s,%s,%s,%s)
        """, (r.order_id, r.customer, r.amount, batch))
    conn.commit()

chunks = [df[i:i+500] for i in range(0,len(df),500)]

threads = []
for c in chunks:
    t = threading.Thread(target=load_chunk, args=(c,))
    t.start()
    threads.append(t)

for t in threads:
    t.join()

