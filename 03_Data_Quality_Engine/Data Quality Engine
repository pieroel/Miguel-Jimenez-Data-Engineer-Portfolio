🧬 rules.py (Reglas de calidad)
import re

def valid_email(e):
    return re.match(r"[^@]+@[^@]+\.[^@]+", e)

def valid_phone(p):
    return len(p.replace(" ","").replace("+","")) >= 10

def valid_country(c):
    return c.upper() in ["MX","US","CA","ES"]

def valid_date(d):
    return "-" in d

🧪 validate.py
import pandas as pd
from rules import *

df = pd.read_csv("data/input.csv")

good = []
bad = []

for _, r in df.iterrows():
    if valid_email(r["email"]) and valid_phone(r["phone"]) and valid_date(r["birthdate"]):
        good.append(r)
    else:
        bad.append(r)

pd.DataFrame(good).to_csv("data/valid.csv", index=False)
pd.DataFrame(bad).to_csv("data/rejected.csv", index=False)

